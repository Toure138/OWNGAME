// Schéma Prisma pour « Qui veut gagner 20 millions ? »

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  passwordHash  String
  pseudo        String
  fullName      String?
  country       String   @default("France")
  avatarUrl     String?
  role          String   @default("USER") // USER | ADMIN
  banned        Boolean  @default(false)
  level         Int      @default(1)
  xp            Int      @default(0)
  gamesPlayed   Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  totalScore    Int      @default(0)
  bestStreak    Int      @default(0)
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gamesAsPlayerA Game[]   @relation("PlayerA")
  gamesAsPlayerB Game[]   @relation("PlayerB")
  notifications  Notification[]
  achievements   Achievement[]

  @@index([totalScore])
  @@index([country])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  icon        String?
  color       String?
  questions   Question[]
  createdAt   DateTime   @default(now())
}

model Question {
  id            String   @id @default(cuid())
  text          String   @unique
  propositionA  String
  propositionB  String
  propositionC  String
  propositionD  String
  correctAnswer String // "A" | "B" | "C" | "D"
  explanation   String?
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  timesAnswered Int      @default(0)
  timesCorrect  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([difficulty])
}

model Game {
  id             String    @id @default(cuid())
  playerAId      String
  playerBId      String
  status         String    @default("WAITING") // WAITING | IN_PROGRESS | FINISHED
  categoryFilter String? // null = toutes catégories
  questionsData  String // JSON : détail de chaque question de la partie
  totalQuestions Int       @default(20)
  currentTurn    Int       @default(0)
  scoreA         Int       @default(0)
  scoreB         Int       @default(0)
  correctA       Int       @default(0)
  correctB       Int       @default(0)
  avgTimeA       Float     @default(0)
  avgTimeB       Float     @default(0)
  winnerId       String?
  forfeit        Boolean   @default(false)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  playerA User @relation("PlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB User @relation("PlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@index([playerAId])
  @@index([playerBId])
  @@index([finishedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // INVITE | GAME_WON | GAME_LOST | GAME_DRAW | ACHIEVEMENT | RANK_UP | INFO
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  code        String // FIRST_WIN | TEN_WINS | STREAK_3 | …
  name        String
  description String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
}
