# Voir https://help.github.com/articles/ignoring-files/

# Dépendances
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests
/coverage

# Next.js
/.next/
/out/
/build

# Base de données SQLite locale (recréée par `npm run db:prepare`)
/db/
*.db
*.db-journal
*.sqlite

# Variables d'environnement — ne jamais versionner de secret.
# .env.example, lui, est suivi : il documente les variables attendues.
.env
.env.*
!.env.example

# Divers
.DS_Store
*.pem
.vercel

# Journaux
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Outillage de l'environnement de développement d'origine
.claude
.z-ai-config
.zscripts/
/skills/
local-*
prompt
