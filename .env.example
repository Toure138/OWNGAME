# Copiez ce fichier en `.env` pour le développement local.
# Sur Render, ces variables se définissent dans les paramètres du service
# (render.yaml en déclare déjà la plupart).

# --- Base de données -------------------------------------------------------
# SQLite. Un chemin relatif est résolu depuis le dossier `prisma/`.
DATABASE_URL="file:../db/qvgdm.db"

# --- Sécurité --------------------------------------------------------------
# Secret de signature des jetons de session (HMAC-SHA256).
# Générez-en un avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sans cette variable en production, un secret de développement est utilisé et
# un avertissement est écrit dans les journaux.
JWT_SECRET="changez-moi-en-production"

# --- Compte administrateur créé au premier peuplement ----------------------
ADMIN_EMAIL="admin@qvgdm.fr"
ADMIN_PASSWORD="admin123"

# --- Peuplement ------------------------------------------------------------
# "true" ajoute quinze joueurs de démonstration (mot de passe : demo123),
# utiles pour visualiser les classements. Laissez "false" en production réelle.
SEED_DEMO_USERS="false"
